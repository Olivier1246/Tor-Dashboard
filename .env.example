# ---------------------------------------------------------------------------
# Tor Dashboard — configuration
# Copier ce fichier en .env et adapter les valeurs.
# ---------------------------------------------------------------------------

# Clé secrète des sessions/cookies signés (OBLIGATOIRE, longue et aléatoire)
# Générer avec :  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please-with-a-long-random-value

# --- Serveur web -----------------------------------------------------------
# On écoute uniquement en local : l'exposition externe passe par l'onion service
HOST=127.0.0.1
PORT=8080

# Marque la session comme "secure" (cookie HTTPS only).
# Laisser à 0 derrière un onion service (HTTP local), 1 derrière un proxy TLS.
COOKIE_SECURE=0

# --- Connexion au ControlPort de Tor --------------------------------------
TOR_CONTROL_PORT=9051
# Laisser vide pour l'authentification par cookie (recommandé sous Debian).
# Sinon, mot de passe du HashedControlPassword défini dans torrc.
TOR_CONTROL_PASSWORD=

# --- Contrôle systemd ------------------------------------------------------
# Nom de l'unité systemd du relais (Debian : tor@default ; certains : tor)
TOR_SERVICE=tor@default

# Chemin du torrc édité par le dashboard
TORRC_PATH=/etc/tor/torrc

# Helper privilégié appelé via sudo (start/stop/restart/savetorrc)
HELPER_PATH=/usr/local/bin/tor-dashboard-helper

# Fichier hostname de l'onion service du dashboard (pour afficher l'adresse .onion)
ONION_HOSTNAME_FILE=/var/lib/tor/dashboard/hostname

# --- Comptes utilisateurs --------------------------------------------------
# Fichier JSON des identifiants (créé via scripts/manage.py)
USERS_FILE=users.json

# Durée d'inactivité avant déconnexion (secondes)
SESSION_MAX_AGE=3600
