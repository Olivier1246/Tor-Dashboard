# ---------------------------------------------------------------------------
# Tor Dashboard -- configuration
# Copy this file to .env and adjust the values.
# ---------------------------------------------------------------------------

# Secret key for signed sessions/cookies (REQUIRED, long and random)
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please-with-a-long-random-value

# --- Web server ------------------------------------------------------------
# We listen on localhost only: external exposure goes through the onion service
HOST=127.0.0.1
PORT=8080

# Marks the session as "secure" (HTTPS-only cookie).
# Keep 0 behind an onion service (local HTTP), 1 behind a TLS proxy.
COOKIE_SECURE=0

# --- Connection to Tor's ControlPort ---------------------------------------
TOR_CONTROL_PORT=9051
# Leave empty for cookie authentication (recommended on Debian).
# Otherwise, the HashedControlPassword password defined in torrc.
TOR_CONTROL_PASSWORD=

# --- systemd control -------------------------------------------------------
# Name of the relay's systemd unit (Debian: tor@default; some: tor)
TOR_SERVICE=tor@default

# Path of the torrc edited by the dashboard
TORRC_PATH=/etc/tor/torrc

# Privileged helper called via sudo (start/stop/restart/savetorrc)
HELPER_PATH=/usr/local/bin/tor-dashboard-helper

# Hostname file of the dashboard onion service (to show the .onion address)
ONION_HOSTNAME_FILE=/var/lib/tor/dashboard/hostname

# --- User accounts ---------------------------------------------------------
# JSON file of credentials (created via scripts/manage.py)
USERS_FILE=users.json

# Idle time before logout (seconds)
SESSION_MAX_AGE=3600
