# Line-ending normalization.
# Default: LF in the repository (deployment on a Linux VM).
* text=auto eol=lf

# Linux scripts and deployment files: LF mandatory (otherwise bash breaks)
*.sh                          text eol=lf
*.py                          text eol=lf
deploy/tor-dashboard-helper   text eol=lf
deploy/tor-dashboard.service  text eol=lf
deploy/sudoers-tor-dashboard  text eol=lf
deploy/helper.conf.example    text eol=lf

# Windows-specific files
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries (never converted)
*.png binary
*.jpg binary
*.ico binary
