#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# tor-dashboard-helper — unique point d'élévation de privilèges du dashboard.
#
# Installé en root dans /usr/local/bin et autorisé via sudoers SANS mot de
# passe pour l'utilisateur du dashboard. Il n'expose QUE des sous-commandes
# fixes : aucune commande arbitraire ne peut être exécutée en root.
#
#   tor-dashboard-helper start|stop|restart|reload|status
#   tor-dashboard-helper savetorrc      (lit le nouveau torrc sur stdin)
# ---------------------------------------------------------------------------
set -euo pipefail

# Réglages surchargés par /etc/tor-dashboard/helper.conf si présent.
SERVICE="tor@default"
TORRC="/etc/tor/torrc"
TOR_USER="debian-tor"          # utilisateur réel du démon Tor
CONF="/etc/tor-dashboard/helper.conf"
[ -r "$CONF" ] && . "$CONF"

usage() {
  echo "usage: $0 {start|stop|restart|reload|status|savetorrc}" >&2
  exit 64
}

case "${1:-}" in
  start)   exec systemctl start   "$SERVICE" ;;
  stop)    exec systemctl stop    "$SERVICE" ;;
  restart) exec systemctl restart "$SERVICE" ;;
  reload)  exec systemctl reload  "$SERVICE" ;;
  status)  exec systemctl is-active "$SERVICE" ;;
  savetorrc)
    tmp="$(mktemp /tmp/torrc.XXXXXX)"
    trap 'rm -f "$tmp"' EXIT
    cat > "$tmp"                              # nouveau torrc depuis stdin
    chmod 0644 "$tmp"                         # lisible par l'utilisateur Tor
    # Valider EN TANT QU'UTILISATEUR TOR : sinon Tor croit tourner sous le
    # mauvais user et refuse à tort le HiddenServiceDir (appartenant à
    # debian-tor), produisant un faux « Failed to configure rendezvous options ».
    if command -v runuser >/dev/null 2>&1; then
      verify() { runuser -u "$TOR_USER" -- tor --verify-config -f "$tmp"; }
    else
      verify() { sudo -u "$TOR_USER" tor --verify-config -f "$tmp"; }
    fi
    if ! verify 1>&2; then
      echo "Configuration invalide — aucune modification appliquée." >&2
      exit 3
    fi
    install -o root -g root -m 644 "$tmp" "$TORRC"
    echo "torrc validé et installé."
    ;;
  *) usage ;;
esac
