#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# tor-dashboard-helper -- the dashboard's single privilege-escalation point.
#
# Installed as root in /usr/local/bin and allowed via sudoers WITHOUT a
# password for the dashboard user. It exposes ONLY fixed sub-commands: no
# arbitrary command can ever be executed as root.
#
#   tor-dashboard-helper start|stop|restart|reload|status
#   tor-dashboard-helper savetorrc      (reads the new torrc from stdin)
# ---------------------------------------------------------------------------
set -euo pipefail

# Settings overridden by /etc/tor-dashboard/helper.conf if present.
SERVICE="tor@default"
TORRC="/etc/tor/torrc"
TOR_USER="debian-tor"          # actual user of the Tor daemon
CONF="/etc/tor-dashboard/helper.conf"
[ -r "$CONF" ] && . "$CONF"

usage() {
  echo "usage: $0 {start|stop|restart|reload|status|savetorrc}" >&2
  exit 64
}

case "${1:-}" in
  start)   exec systemctl start   "$SERVICE" ;;
  stop)    exec systemctl stop    "$SERVICE" ;;
  restart) exec systemctl restart "$SERVICE" ;;
  reload)  exec systemctl reload  "$SERVICE" ;;
  status)  exec systemctl is-active "$SERVICE" ;;
  savetorrc)
    tmp="$(mktemp /tmp/torrc.XXXXXX)"
    trap 'rm -f "$tmp"' EXIT
    cat > "$tmp"                              # new torrc from stdin
    chmod 0644 "$tmp"                         # readable by the Tor user
    # Validate AS THE TOR USER: otherwise Tor thinks it runs as the wrong user
    # and wrongly rejects the HiddenServiceDir (owned by debian-tor), producing
    # a spurious "Failed to configure rendezvous options".
    if command -v runuser >/dev/null 2>&1; then
      verify() { runuser -u "$TOR_USER" -- tor --verify-config -f "$tmp"; }
    else
      verify() { sudo -u "$TOR_USER" tor --verify-config -f "$tmp"; }
    fi
    if ! verify 1>&2; then
      echo "Configuration invalide — aucune modification appliquée." >&2
      exit 3
    fi
    install -o root -g root -m 644 "$tmp" "$TORRC"
    echo "torrc validé et installé."
    ;;
  *) usage ;;
esac
