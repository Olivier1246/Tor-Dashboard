# Allows the dashboard user to run ONLY the helper, without a password.
# Install into /etc/sudoers.d/tor-dashboard (mode 0440) then check with:
#   visudo -cf /etc/sudoers.d/tor-dashboard
#
# The helper is root-owned and not modifiable by tordash: the surface is
# limited to its fixed sub-commands (start/stop/restart/reload/status/savetorrc).

tordash ALL=(root) NOPASSWD: /usr/local/bin/tor-dashboard-helper
