# ===========================================================================
# torrc snippet to merge into your /etc/tor/torrc
# Enables: (1) the ControlPort for metrics, (2) the dashboard onion service
# for secure remote access.
# ===========================================================================

## --- 1. ControlPort (metrics read by the dashboard) -----------------------
# The dashboard connects to it locally to read the relay state.
ControlPort 9051
# Cookie authentication: the tordash user must be in the debian-tor group to
# read the cookie file.
CookieAuthentication 1
# CookieAuthFileGroupReadable only has effect if CookieAuthFile is explicit
# (otherwise Tor warns "will have no effect"). So we set both.
CookieAuthFile /run/tor/control.authcookie
CookieAuthFileGroupReadable 1
# (Alternative: HashedControlPassword 16:... and set TOR_CONTROL_PASSWORD)

## --- 2. Dashboard onion service -------------------------------------------
# Makes the dashboard reachable outside the LAN via a .onion address, without
# opening any port on the Internet. The onion service port 80 is forwarded to
# the local dashboard (127.0.0.1:8080).
HiddenServiceDir /var/lib/tor/dashboard/
HiddenServicePort 80 127.0.0.1:8080
# Pin the onion protocol version (v3, default).
HiddenServiceVersion 3

## --- 3. Example relay configuration (adapt to your case) ------------------
# Nickname MyRelay
# ContactInfo admin@example.com
# ORPort 9001
# RelayBandwidthRate 10 MBytes
# RelayBandwidthBurst 20 MBytes
# ExitRelay 0
# After any change: "Control" page -> Reload / Restart.
