# systemd unit for the dashboard.
# Starts AFTER the Tor relay (After=/Requires=tor.service) so that the
# ControlPort is available right from launch.  -> /etc/systemd/system/

[Unit]
Description=Tor Relay Dashboard
Documentation=https://localhost/
After=network-online.target tor.service
Wants=network-online.target
Requires=tor.service

[Service]
Type=simple
User=tordash
Group=tordash
SupplementaryGroups=debian-tor systemd-journal
WorkingDirectory=/opt/tor-dashboard
EnvironmentFile=/opt/tor-dashboard/.env
ExecStart=/opt/tor-dashboard/.venv/bin/uvicorn app.main:app \
          --host 127.0.0.1 --port 8080 --proxy-headers
Restart=on-failure
RestartSec=3

# --- Hardening --------------------------------------------------------------
NoNewPrivileges=false
ProtectSystem=full
# /etc is read-only (ProtectSystem=full); we reopen ONLY /etc/tor for writing
# so the helper can install the validated torrc. The helper inherits the
# service namespace even through sudo.
ReadWritePaths=/etc/tor
ProtectHome=true
PrivateTmp=false
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# NoNewPrivileges stays false because the dashboard calls sudo (helper).
# PrivateTmp is false to share /tmp with the helper during savetorrc.

[Install]
WantedBy=multi-user.target
