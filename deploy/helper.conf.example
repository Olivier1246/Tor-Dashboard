# Privileged helper configuration -- copy to /etc/tor-dashboard/helper.conf
# (root:root, mode 0644). Sourced by tor-dashboard-helper.

# Name of the relay's systemd unit (Debian: tor@default)
SERVICE="tor@default"

# Path of the torrc managed by the dashboard
TORRC="/etc/tor/torrc"

# Actual user of the Tor daemon (used to validate the torrc under the right account)
TOR_USER="debian-tor"
